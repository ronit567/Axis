{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx"
  },
  "include": [
    "App.tsx",
    "screens/**/*.js",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "components/**/*.js",
    "components/**/*.ts",
    "components/**/*.tsx",
    "config/**/*.js",
    "config/**/*.ts",
    "config/**/*.tsx",
    "convex/_generated/**/*.ts",
    "convex/_generated/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
